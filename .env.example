# Copy this file to .env and put your Razorpay TEST MODE keys in it.
# Dashboard -> Account & Settings -> API Keys (make sure Test Mode is ON).
# Never commit the real .env file.
RAZORPAY_KEY_ID=YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET

# Optional: enables POST /api/v1/webhooks/razorpay
# Dashboard -> Account & Settings -> Webhooks -> secret you chose there.
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Client apps allowed to use this payment service (comma separated).
# Each app sends its id in the X-App-Id header; payments are scoped per app.
APP_IDS=web

# Browser origins allowed by CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public address of this service. POST /api/v1/orders returns
# payment_url = <PUBLIC_BASE_URL>/pay/<order_id>, the hosted Razorpay payment page.
# PUBLIC_BASE_URL=https://pay.example.com

# PostgreSQL storage for orders and payments. Leave DB_CONNECTION empty to use data/*.json instead.
# Tables are created on startup; on the first run existing data/*.json records are imported.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=Razorpay
DB_USERNAME=postgres
DB_PASSWORD=YOUR_DB_PASSWORD

# PORT=8000
